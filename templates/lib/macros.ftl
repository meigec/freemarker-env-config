<#-- Shared building blocks, imported by every template (an import adds no output of its own). -->

<#-- Standard header so nobody edits generated files by hand. -->
<#macro header file>
# ${file}: generated by FreeMarker from Git-versioned templates. DO NOT EDIT.
# client=${client.id} environment=${env.name}
</#macro>

<#-- Internal URL of a service in this client's environment namespace. -->
<#function serviceUrl svc>
  <#return "http://" + svc.name + "." + client.id + "-" + env.name + ".svc.cluster.local:" + svc.port?c>
</#function>

<#-- Secrets are NEVER rendered: only a reference resolved at runtime by the secret manager. -->
<#function secretRef name>
  <#return "sm://" + client.id + "-" + env.name + "/" + name>
</#function>
